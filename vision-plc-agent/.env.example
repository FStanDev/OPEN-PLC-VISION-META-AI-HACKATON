# Copy to .env and fill in. Never commit .env.
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1   # confirm against the hackathon docs
LLM_MODEL=muse-spark-1.3
VISION_MODEL=sam-3.1                       # confirm the exact model id

PI_HOST=raspberrypi                        # ssh raspberrypi; services use the Tailscale address
PI_BIND=                                 # Tailscale IP of the Pi; Pi services bind here
OPENPLC_URL=https://raspberrypi:8443
OPENPLC_USER=
OPENPLC_PASSWORD=
MODBUS_PORT=5020                           # must match conf/modbus_slave.json (packager default 5020)
STIMULUS_URL=http://raspberrypi:8081
FRAMES_URL=http://raspberrypi:8082
