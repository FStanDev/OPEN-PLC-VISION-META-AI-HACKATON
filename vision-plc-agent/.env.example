# Copy to .env and fill in. Never commit .env.
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1   # confirm against the hackathon docs
LLM_MODEL=muse-spark-1.3
VISION_MODEL=sam-3.1                       # confirm the exact model id

PI_HOST=raspberrypi                        # ssh alias only; HTTP/Modbus URLs below need the Pi's IP
PI_BIND=                                   # optional; Pi services bind 0.0.0.0 when empty
OPENPLC_URL=https://192.168.1.198:8443           # Pi IP: "raspberrypi" is only an ssh alias
OPENPLC_USER=
OPENPLC_PASSWORD=
MODBUS_PORT=5020                           # must match conf/modbus_slave.json (packager default 5020)
STIMULUS_URL=http://192.168.1.198:8081
FRAMES_URL=http://192.168.1.198:8082
